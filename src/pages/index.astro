---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';

// Projects are fetched LIVE from the canonical feed on the main portfolio when
// the page loads in the browser (see the <script> at the bottom) — one source of
// truth (adityajain.me → src/data/projects.ts, served at /projects.json), always
// current with no rebuild of this site. Image URLs in the feed are already
// absolute (https://adityajain.me/img/...). GitHub Pages serves the feed with
// `Access-Control-Allow-Origin: *`, so the cross-origin fetch works from here.
// This page ships as a static shell + loading state; cards render client-side.
---

<BaseLayout
  title="Projects — Aditya Jain"
  description="A showcase of Aditya Jain's projects across machine learning, deep learning, reinforcement learning, computer vision, NLP, and more."
>
  <!-- ============================ HERO ============================ -->
  <section class="hero section" id="about">
    <div class="container">
      <p class="eyebrow" data-reveal>Selected work</p>
      <h1 class="hero-title" data-reveal>Projects</h1>
      {profile.bio.map((p) => <p class="hero-bio" data-reveal>{p}</p>)}
      <div class="hero-cta" data-reveal>
        <a href="https://adityajain.me" class="btn btn-primary">
          <Icon name="arrow" size={16} class="arrow-back" /> Back to portfolio
        </a>
        <a href="#projects" class="btn btn-ghost">Browse projects</a>
      </div>
      <ul class="hero-social" data-reveal aria-label="Social links">
        {
          profile.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============================ PROJECTS ============================ -->
  <!-- Cards are fetched LIVE from adityajain.me/projects.json on load; the
       markup below is a static shell + loading state. See the <script> at the
       bottom of this file for the fetch + render logic. -->
  <section class="section section-alt" id="projects">
    <div class="container">
      <p class="eyebrow" data-reveal id="proj-count">Projects</p>
      <h2 class="section-title" data-reveal>Everything I've built</h2>
      <div class="proj-grid" id="proj-grid" aria-busy="true" aria-live="polite">
        <p class="proj-status">Loading projects…</p>
      </div>
    </div>
  </section>

  <!-- ============================ CONTACT ============================ -->
  <section class="section" id="contact">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow" data-reveal>Say hello</p>
        <h2 class="section-title" data-reveal>Get in touch</h2>
        <p class="contact-lede" data-reveal>
          Interested in one of these projects, or want to collaborate? Drop a message and I'll
          get back to you.
        </p>
        <ul class="contact-details" data-reveal>
          <li>
            <Icon name="mail" size={18} />
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
          <li>
            <Icon name="location" size={18} />
            <span>{profile.location}</span>
          </li>
        </ul>
      </div>
      <form class="contact-form" action={profile.formspree} method="POST" data-reveal>
        <input type="hidden" name="_subject" value="Contact request from projects.adityajain.me" />
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required placeholder="you@example.com" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea name="message" id="message" rows="4" required placeholder="Write your message…"
          ></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message <Icon name="arrow" size={16} /></button>
      </form>
    </div>
  </section>

  <script>
    // Render the projects live from the canonical feed on the main portfolio.
    // One source of truth (adityajain.me/projects.json) — this page never goes
    // stale and needs no rebuild when the list changes. GitHub Pages serves the
    // feed with `Access-Control-Allow-Origin: *`, so this cross-origin fetch works.
    const FEED = 'https://adityajain.me/projects.json';
    const grid = document.getElementById('proj-grid');
    const countEl = document.getElementById('proj-count');

    // Escape untrusted feed values before interpolating into HTML strings.
    const esc = (s) =>
      String(s ?? '').replace(
        /[&<>"']/g,
        (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
      );

    // Inlined SVGs (mirror src/components/Icon.astro's ui glyphs) so injected
    // cards need no Astro components at runtime.
    const ARROW =
      '<svg class="card-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
    const EXTERNAL =
      '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>';
    const GITHUB =
      '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 016 0C17.3 5 18.3 5.3 18.3 5.3c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>';

    function cardHTML(p) {
      const media = p.image
        ? `<div class="card-media"><img src="${esc(p.image)}" alt="${esc(p.title)} preview" loading="lazy"></div>`
        : '';
      // Demo (filled) when there's a live demo; Code (ghost) always; Blog (ghost)
      // when there's a companion post. Mirror the main-site homepage tiles.
      const chips = [];
      if (p.demo)
        chips.push(
          `<a class="card-btn" href="${esc(p.demo)}" target="_blank" rel="noopener noreferrer">${EXTERNAL} Demo</a>`,
        );
      chips.push(
        `<a class="card-btn card-btn-ghost" href="${esc(p.href)}" target="_blank" rel="noopener noreferrer">${GITHUB} Code</a>`,
      );
      if (p.blog)
        chips.push(
          `<a class="card-btn card-btn-ghost" href="${esc(p.blog)}" target="_blank" rel="noopener noreferrer">${EXTERNAL} Blog</a>`,
        );
      const links = `<div class="card-links">${chips.join('')}</div>`;
      const tags = Array.isArray(p.tags) ? p.tags.map(esc).join(' · ') : '';
      // Whole tile opens the demo if there is one, else the code link.
      return `<article class="card">${media}<div class="card-body"><div class="card-head"><h3><a class="card-link" href="${esc(
        p.demo || p.href,
      )}" target="_blank" rel="noopener noreferrer">${esc(
        p.title,
      )}</a></h3>${ARROW}</div><p class="card-desc">${esc(
        p.description,
      )}</p><div class="card-foot"><p class="card-tags">${tags}</p>${links}</div></div></article>`;
    }

    async function loadProjects() {
      if (!grid) return;
      try {
        const res = await fetch(FEED, { cache: 'no-store' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const projects = await res.json();
        if (!Array.isArray(projects) || projects.length === 0) throw new Error('empty feed');
        grid.innerHTML = projects.map(cardHTML).join('');
        // Stagger the fade-in (see #projects .card animation in the global styles).
        grid.querySelectorAll('.card').forEach((el, i) => el.style.setProperty('--i', String(i)));
        grid.setAttribute('aria-busy', 'false');
        if (countEl) countEl.textContent = `${projects.length} projects`;
      } catch {
        grid.innerHTML =
          '<p class="proj-status proj-error">Couldn’t load projects right now — see them all on <a href="https://adityajain.me" target="_blank" rel="noopener">adityajain.me</a>.</p>';
        grid.setAttribute('aria-busy', 'false');
      }
    }

    loadProjects();
  </script>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }
  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin-block: 0.5rem 1.3rem;
  }
  .hero-bio {
    color: var(--text-muted);
    max-width: 60ch;
    margin-bottom: 1rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.6rem;
  }
  /* Point the shared right-arrow glyph back to the left for "Back". */
  .arrow-back {
    transform: rotate(180deg);
  }
  .hero-social {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin-top: 2rem;
  }
  .hero-social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 10px;
    color: var(--text-muted);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    transition: all 0.15s var(--ease);
  }
  .hero-social a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .section-alt {
    background: var(--bg-subtle);
    border-block: 1px solid var(--border);
  }

  /* ---------- Contact ---------- */
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact-lede {
    color: var(--text-muted);
    max-width: 40ch;
    margin-bottom: 1.5rem;
  }
  .contact-details {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .contact-details li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-muted);
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--text-muted);
  }
  .field input,
  .field textarea {
    font: inherit;
    padding: 0.7rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--bg);
    color: var(--text);
    resize: vertical;
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .contact-form .btn {
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<!-- Project cards are injected client-side (fetched from adityajain.me), so they
     lack Astro's scoped data-astro-cid-* attributes — their styles must be global.
     Namespaced under #projects so nothing leaks into the rest of the page. -->
<style is:global>
  #projects .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.4rem;
    align-items: start;
  }
  #projects .proj-status {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.5rem 0 1rem;
  }
  #projects .proj-status.proj-error a {
    color: var(--accent);
  }
  #projects .card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    overflow: hidden;
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease),
      box-shadow 0.2s var(--ease);
  }
  #projects .card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  #projects .card-media {
    aspect-ratio: 16 / 9;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  #projects .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s var(--ease);
  }
  #projects .card:hover .card-media img {
    transform: scale(1.04);
  }
  #projects .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.3rem 1.4rem;
    flex: 1;
  }
  #projects .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  #projects .card-head h3 {
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  /* Stretched title link: the whole card opens the repo, while Demo/Blog
     chips sit above it and stay independently clickable. */
  #projects .card-link {
    color: inherit;
  }
  #projects .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #projects .card:hover .card-head h3 {
    color: var(--accent);
  }
  #projects .card-arrow {
    color: var(--text-faint);
    flex-shrink: 0;
    margin-top: 0.15rem;
    transform: rotate(-45deg);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  #projects .card:hover .card-arrow {
    color: var(--accent);
    transform: rotate(-45deg) translateX(3px);
  }
  #projects .card-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  #projects .card-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  #projects .card-tags {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.01em;
    color: var(--text-faint);
  }
  #projects .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  /* Demo (filled) + Code/Blog (ghost) actions. Above the stretched link
     (z-index 1) so they're independently clickable. Mirrors the main site. */
  #projects .card-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1;
    padding: 0.34rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg);
    transition: background 0.15s var(--ease), border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  #projects .card-btn:hover {
    background: color-mix(in srgb, var(--accent) 85%, #000);
    color: var(--bg);
  }
  #projects .card-btn-ghost {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--text-muted);
  }
  #projects .card-btn-ghost:hover {
    background: transparent;
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Staggered fade-in for the freshly injected cards (they aren't observed by
     the BaseLayout data-reveal observer, which only runs once at page load). */
  @media (prefers-reduced-motion: no-preference) {
    #projects .card {
      animation: projCardIn 0.4s var(--ease) both;
      animation-delay: calc(var(--i, 0) * 45ms);
    }
    @keyframes projCardIn {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
